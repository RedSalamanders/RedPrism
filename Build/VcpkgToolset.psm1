Set-StrictMode -Version Latest
$root = Split-Path -Parent $PSScriptRoot
Import-Module (Join-Path $root '.ci-engine/Tools/Modules/Ci.EngineBinding.psm1') -ErrorAction Stop
foreach ($module in @('VisualStudio.psm1', 'VcpkgTriplet.psm1')) {
    Import-Module (Resolve-CiPinnedEngineModule -ProjectRoot $root -Name $module) -Scope Local -ErrorAction Stop
}
$header = '# RedPrism: build with the Visual Studio installation and default MSVC toolset MSBuild uses (generated by vcpkg-install.ps1; do not edit).'

function Get-RedPrismDefaultToolset {
    [CmdletBinding()]
    param([Parameter(Mandatory)][string] $Installation)

    Get-CiDefaultMsvcToolset -Installation $Installation
}

function Get-RedPrismVcpkgOverlayTripletText {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][AllowEmptyString()][string] $SourceText,
        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string] $Installation,
        [Parameter(Mandatory)][ValidatePattern('^[0-9]+[.][0-9]+$')][string] $ToolsetVersion
    )

    Get-CiVcpkgOverlayTripletText -SourceText $SourceText -Installation $Installation -ToolsetVersion $ToolsetVersion -Header $header
}

function Update-RedPrismVcpkgOverlayTriplet {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string] $SourceTripletPath,
        [Parameter(Mandatory)] $Toolset,
        [Parameter(Mandatory)][string] $OutputDirectory
    )

    Update-CiVcpkgOverlayTriplet -ProjectRoot $root -SourceTripletPath $SourceTripletPath -Toolset $Toolset -OutputDirectory $OutputDirectory -Header $header
}

Export-ModuleMember -Function Get-RedPrismDefaultToolset, Get-RedPrismVcpkgOverlayTripletText, Update-RedPrismVcpkgOverlayTriplet
