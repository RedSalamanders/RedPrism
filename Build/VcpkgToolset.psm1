# The MSVC toolset MSBuild compiles RedPrism with, and the overlay triplets that pin vcpkg to it. Left alone, vcpkg builds
# every dependency with the newest toolset of the Visual Studio installation it prefers, while MSBuild compiles and links
# with that installation's default toolset. The two differ when a newer toolset is installed beside the default. The newer
# one can lack a compiler for a target (VS 18 Insiders' 14.52, beside the default 14.51, has no x64-hosted ARM64 compiler, so
# every fresh ARM64 restore failed while configuring its first library with LNK1104 on MSVCRTD.lib), and compiled libraries
# from a toolset newer than the one that links them are a link hazard (static libraries, ASan STL annotations).
#
# An overlay triplet is the text of a stock or RedPrism triplet, copied unchanged, plus two pins; vcpkg takes an overlay in
# place of the triplet of the same name. This mirrors DxUi's Tools/VcpkgTriplet.psm1, so both restores pin the same way, but it
# depends on neither a restored DxUi checkout nor its pin: vcpkg-install.ps1 runs before restore-dxui.ps1, and on its own.
#
# Nothing here installs anything, names a developer's installation or runs vswhere (discovery is Build/VisualStudioDiscovery.psm1).
# Plain ASCII and Windows PowerShell 5.1 compatible, like the scripts that import it.
Set-StrictMode -Version Latest

function Get-RedPrismDefaultToolset {
    <# The MSVC toolset MSBuild compiles with when a project names no version: the one in the installation's
       VC\Auxiliary\Build\Microsoft.VCToolsVersion.default.txt, such as 14.51.36231, which its major.minor (14.51) selects. It can
       differ from the newest toolset installed side by side, which is what vcpkg would choose. A file that is missing or
       holds anything else fails here with what to repair, before anything is cloned or restored. #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][string] $Installation)
    $path = [IO.Path]::GetFullPath([IO.Path]::Combine($Installation, 'VC', 'Auxiliary', 'Build', 'Microsoft.VCToolsVersion.default.txt'))
    $cause = "Cannot pin vcpkg to the default MSVC toolset of the Visual Studio installation at '$Installation'"
    if (-not [IO.File]::Exists($path)) {
        throw "${cause}: '$path' does not exist. Install the Desktop development with C++ workload (MSVC build tools) in the Visual Studio Installer, or repair the installation, and try again."
    }
    $text = [IO.File]::ReadAllText($path).Trim()
    $match = [regex]::Match($text, '^(?<majorMinor>[0-9]+\.[0-9]+)\.[0-9]+\z')
    if (-not $match.Success) {
        $shown = $text -replace '\s+', ' '
        if ($shown.Length -gt 60) { $shown = $shown.Substring(0, 60) + '...' }
        $holds = if ($shown) { "holds '$shown'" } else { 'is empty' }
        throw "${cause}: '$path' $holds, not a toolset version such as 14.51.36231. Repair the installation in the Visual Studio Installer so the file names the default toolset, and try again."
    }
    return [pscustomobject]@{ Installation = $Installation; VersionFile = $path; Version = $text; MajorMinor = $match.Groups['majorMinor'].Value }
}

function ConvertTo-CMakeQuotedArgument([string] $Value) {
    # In a CMake quoted argument a backslash, a double quote and a dollar sign are special; every other character is literal.
    return '"' + [regex]::Replace($Value, '[\\"$]', '\$&') + '"'
}

function Get-RedPrismVcpkgOverlayTripletText {
    <# The overlay triplet's text: the source text unchanged, then the pins. It keeps the source text's line endings (the stock
       arm64-windows.cmake has CRLF and x64-windows.cmake LF), so the copy stays one consistent file. Pure: no I/O. #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][AllowEmptyString()][string] $SourceText,
        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string] $Installation,
        [Parameter(Mandatory)][ValidatePattern('^[0-9]+\.[0-9]+$')][string] $ToolsetVersion
    )
    $newline = if ($SourceText.Contains("`r`n")) { "`r`n" } else { "`n" }
    $text = $SourceText
    if ($text.Length -and -not $text.EndsWith("`n", [StringComparison]::Ordinal)) { $text += $newline }
    if ($text.Length) { $text += $newline }
    $pins = @(
        '# RedPrism: build with the Visual Studio installation and default MSVC toolset MSBuild uses (generated by vcpkg-install.ps1; do not edit).',
        "set(VCPKG_VISUAL_STUDIO_PATH $(ConvertTo-CMakeQuotedArgument $Installation))",
        "set(VCPKG_PLATFORM_TOOLSET_VERSION $(ConvertTo-CMakeQuotedArgument $ToolsetVersion))")
    return $text + (($pins -join $newline) + $newline)
}

function Write-RedPrismFileIfChanged([string] $Path, [byte[]] $Bytes) {
    # Only when the bytes differ, so an unchanged restore leaves the file and its timestamp alone.
    $changed = -not ([IO.File]::Exists($Path) -and [Convert]::ToBase64String([IO.File]::ReadAllBytes($Path)) -ceq [Convert]::ToBase64String($Bytes))
    if ($changed) {
        [void][IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($Path))
        [IO.File]::WriteAllBytes($Path, $Bytes)
    }
    return $changed
}

function Update-RedPrismVcpkgOverlayTriplet {
    <# Writes <OutputDirectory>\<name>.cmake, the overlay of the triplet at SourceTripletPath (the pinned vcpkg checkout's
       triplets\<name>.cmake, or one of RedPrism's own sanitizer triplets) pinned to the toolset that Get-RedPrismDefaultToolset
       returned, and only when the file's bytes would change. A file the triplet names beside itself with
       ${CMAKE_CURRENT_LIST_DIR}/<file> (the sanitizer triplets chainload asan-toolchain.cmake) is copied beside the overlay,
       unchanged, so the name still resolves; such a file that is not there fails here instead of in a configure step.
       Changing the triplet changes vcpkg's package ABI hash, so the first restore after a change rebuilds the packages.
       Returns Triplet, Directory (what --overlay-triplets takes), Path, Changed and Companions (the copied files). #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string] $SourceTripletPath,
        [Parameter(Mandatory)] $Toolset,
        [Parameter(Mandatory)][string] $OutputDirectory
    )
    # Relative paths mean the caller's PowerShell location, which .NET file calls do not know.
    $SourceTripletPath = $PSCmdlet.GetUnresolvedProviderPathFromPSPath($SourceTripletPath)
    $OutputDirectory = $PSCmdlet.GetUnresolvedProviderPathFromPSPath($OutputDirectory)
    if (-not [IO.File]::Exists($SourceTripletPath)) {
        throw "The triplet to pin does not exist: $SourceTripletPath. The vcpkg checkout or the repository does not have it; check the triplet name."
    }
    $name = [IO.Path]::GetFileName($SourceTripletPath)
    $sourceText = [IO.File]::ReadAllText($SourceTripletPath)
    $text = Get-RedPrismVcpkgOverlayTripletText -SourceText $sourceText -Installation $Toolset.Installation -ToolsetVersion $Toolset.MajorMinor
    $path = Join-Path $OutputDirectory $name
    $changed = Write-RedPrismFileIfChanged $path ([Text.UTF8Encoding]::new($false).GetBytes($text))
    $companions = @()
    $sourceDirectory = [IO.Path]::GetDirectoryName($SourceTripletPath)
    foreach ($reference in [regex]::Matches($sourceText, '\$\{CMAKE_CURRENT_LIST_DIR\}/(?<name>[A-Za-z0-9_.\-]+)')) {
        $companionName = $reference.Groups['name'].Value
        $companionSource = Join-Path $sourceDirectory $companionName
        if (-not [IO.File]::Exists($companionSource)) {
            throw "The triplet $SourceTripletPath names '$companionName' beside itself with CMAKE_CURRENT_LIST_DIR, but '$companionSource' does not exist."
        }
        $companionPath = Join-Path $OutputDirectory $companionName
        if (Write-RedPrismFileIfChanged $companionPath ([IO.File]::ReadAllBytes($companionSource))) { $changed = $true }
        $companions += $companionPath
    }
    return [pscustomobject]@{ Triplet = [IO.Path]::GetFileNameWithoutExtension($name); Directory = $OutputDirectory; Path = $path; Changed = $changed; Companions = @($companions) }
}

Export-ModuleMember -Function Get-RedPrismDefaultToolset, Get-RedPrismVcpkgOverlayTripletText, Update-RedPrismVcpkgOverlayTriplet
