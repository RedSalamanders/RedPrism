<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <RequiredMsvcToolsVersion>14.52</RequiredMsvcToolsVersion>
    <SolutionDir Condition="'$(SolutionDir)'==''">$(MSBuildThisFileDirectory)</SolutionDir>
    <RedPrismBuildRoot>$(MSBuildThisFileDirectory).build\</RedPrismBuildRoot>
    <RedPrismOutputRoot Condition="'$(RedPrismOutputRoot)'==''">$(RedPrismBuildRoot)</RedPrismOutputRoot>
    <OutDir>$(RedPrismOutputRoot)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(RedPrismOutputRoot)Intermediate\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
    <TargetName>$(MSBuildProjectName)</TargetName>

    <RedPrismVcpkgPlatformScope Condition="'$(Platform)'=='ARM64'">arm64</RedPrismVcpkgPlatformScope>
    <!-- ASan Debug links a sanitized dependency tree per platform (vcpkg-install.ps1 -Asan, overlay triplets
         x64-windows-asan / arm64-windows-asan; Decision D8, Specs/Plans/WIP/ReviewFixes_2026-09-23.md). Each
         platform's ASan condition is evaluated after that platform's plain baseline above, so it wins. -->
    <RedPrismVcpkgPlatformScope Condition="'$(Platform)'=='x64' and '$(Configuration)'=='ASan Debug'">x64-asan</RedPrismVcpkgPlatformScope>
    <RedPrismVcpkgPlatformScope Condition="'$(Platform)'=='ARM64' and '$(Configuration)'=='ASan Debug'">arm64-asan</RedPrismVcpkgPlatformScope>
    <RedPrismVcpkgPlatformScope Condition="'$(RedPrismVcpkgPlatformScope)'==''">x64</RedPrismVcpkgPlatformScope>
    <RedPrismVcpkgTriplet Condition="'$(Platform)'=='ARM64'">arm64-windows</RedPrismVcpkgTriplet>
    <RedPrismVcpkgTriplet Condition="'$(Platform)'=='x64' and '$(Configuration)'=='ASan Debug'">x64-windows-asan</RedPrismVcpkgTriplet>
    <RedPrismVcpkgTriplet Condition="'$(Platform)'=='ARM64' and '$(Configuration)'=='ASan Debug'">arm64-windows-asan</RedPrismVcpkgTriplet>
    <RedPrismVcpkgTriplet Condition="'$(RedPrismVcpkgTriplet)'==''">x64-windows</RedPrismVcpkgTriplet>
    <VcpkgManifestRoot>$(MSBuildThisFileDirectory)</VcpkgManifestRoot>
    <VcpkgInstalledDir>$(RedPrismBuildRoot)vcpkg_installed\$(RedPrismVcpkgPlatformScope)\</VcpkgInstalledDir>
    <VcpkgEnabled>false</VcpkgEnabled>

    <RedPrismBuildNumber Condition="'$(RedPrismBuildNumber)'==''">0</RedPrismBuildNumber>
    <RedPrismEnableTests Condition="'$(RedPrismEnableTests)'==''">true</RedPrismEnableTests>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='ASan Debug'">
    <EnableASAN>true</EnableASAN>
    <LinkIncremental>false</LinkIncremental>
    <CopyAsanBinariesToOutDir Condition="'$(MSBuildProjectName)'=='RedPrism' or '$(MSBuildProjectName)'=='HostTests' or '$(MSBuildProjectName)'=='DocumentTests' or '$(MSBuildProjectName)'=='IoTests' or '$(MSBuildProjectName)'=='CompositionTests'">true</CopyAsanBinariesToOutDir>
    <CopyAsanBinariesToOutDir Condition="'$(MSBuildProjectName)'!='RedPrism' and '$(MSBuildProjectName)'!='HostTests' and '$(MSBuildProjectName)'!='DocumentTests' and '$(MSBuildProjectName)'!='IoTests' and '$(MSBuildProjectName)'!='CompositionTests'">false</CopyAsanBinariesToOutDir>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)'=='.vcxproj'">
    <ClCompile>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <WarningLevel>EnableAllWarnings</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 /permissive- /Zc:preprocessor %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(RedPrismEnableTests)'=='true'">REDPRISM_ENABLE_TESTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)Common;$(MSBuildThisFileDirectory)RedPrism;$(VcpkgInstalledDir)$(RedPrismVcpkgTriplet)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <ResourceCompile>
      <PreprocessorDefinitions>REDPRISM_VERSION_BUILD=$(RedPrismBuildNumber);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)'=='.vcxproj' and ('$(Configuration)'=='Debug' or '$(Configuration)'=='ASan Debug')">
    <Link>
      <AdditionalLibraryDirectories>$(VcpkgInstalledDir)$(RedPrismVcpkgTriplet)\debug\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <!-- rc.exe never sees ClCompile's own _DEBUG (a separate PreprocessorDefinitions list); without this, every
         RedPrism.rc VS_VERSION_INFO block takes the #else branch and a Debug build's version resource never carries
         VS_FF_DEBUG (RF-707). -->
    <ResourceCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)'=='.vcxproj' and '$(Configuration)'=='Release'">
    <Link>
      <AdditionalLibraryDirectories>$(VcpkgInstalledDir)$(RedPrismVcpkgTriplet)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

<Import Project="$(MSBuildThisFileDirectory)Build\RedMonitor.props" />
  <ItemDefinitionGroup><ClCompile><AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories></ClCompile></ItemDefinitionGroup>
</Project>
