<?xml version="1.0" encoding="utf-8"?>
<Project>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='ASan Debug'">
    <ClCompile>
      <EnableASAN>true</EnableASAN>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <ForcedIncludeFiles>$(MSBuildThisFileDirectory)Common\RequireAddressSanitizer.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
    </ClCompile>
  </ItemDefinitionGroup>
  <Target Name="ValidateRedPrismBuildConfiguration" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)'!='x64' and '$(Platform)'!='ARM64'" Text="RedPrism supports x64 and ARM64." />
    <Error Condition="'$(Configuration)'!='Debug' and '$(Configuration)'!='Release' and '$(Configuration)'!='ASan Debug'" Text="RedPrism supports Debug, Release and ASan Debug." />
  </Target>
  <Target Name="EnableRedPrismNativeCodeAnalysis" BeforeTargets="ClCompile"
          Condition="'$(RedPrismAnalyze)'=='true' and '$(MSBuildProjectExtension)'=='.vcxproj' and ('$(RedPrismAnalysisProbe)'=='true' or '$(MSBuildProjectName)'=='RedPrism' or '$(MSBuildProjectName)'=='HostTests' or '$(MSBuildProjectName)'=='DocumentTests' or '$(MSBuildProjectName)'=='IoTests' or '$(MSBuildProjectName)'=='CompositionTests')">
    <ItemGroup>
      <ClCompile Update="@(ClCompile)">
        <EnablePREfast>true</EnablePREfast>
        <AdditionalOptions>/analyze:plugin EspXEngine.dll /analyze:external- /external:I&quot;$(VcpkgInstalledDir)$(RedPrismVcpkgTriplet)\include&quot; /external:env:INCLUDE %(ClCompile.AdditionalOptions)</AdditionalOptions>
      </ClCompile>
      <ClCompile Update="@(ClCompile)" Condition="'$(DxUiRoot)'!=''">
        <AdditionalOptions>/external:I&quot;$(DxUiResolvedRoot)include&quot; %(ClCompile.AdditionalOptions)</AdditionalOptions>
      </ClCompile>
      <ClCompile Update="@(ClCompile)" Condition="'$(DxUiConsumerOutputRoot)'!=''">
        <AdditionalOptions>/external:I&quot;$(DxUiConsumerOutputRoot)vcpkg_installed\$(Platform)\$(DxUiConsumerTriplet)\include&quot; %(ClCompile.AdditionalOptions)</AdditionalOptions>
      </ClCompile>
      <ClCompile Update="@(ClCompile)"
                 Condition="$([System.String]::Copy('%(ClCompile.FullPath)').StartsWith('$(MSBuildThisFileDirectory)Tests\'))">
        <AdditionalOptions>/analyze:stacksize 131072 %(ClCompile.AdditionalOptions)</AdditionalOptions>
      </ClCompile>
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <RedPrismVcpkgRuntimeDir Condition="('$(Configuration)'=='Debug' or '$(Configuration)'=='ASan Debug')">$(VcpkgInstalledDir)$(RedPrismVcpkgTriplet)\debug\bin\</RedPrismVcpkgRuntimeDir>
    <RedPrismVcpkgRuntimeDir Condition="'$(Configuration)'=='Release'">$(VcpkgInstalledDir)$(RedPrismVcpkgTriplet)\bin\</RedPrismVcpkgRuntimeDir>
  </PropertyGroup>

  <Target Name="CopyRedPrismRuntimeDependencies" AfterTargets="Link"
          Condition="'$(MSBuildProjectExtension)'=='.vcxproj' and ('$(MSBuildProjectName)'=='RedPrism' or '$(MSBuildProjectName)'=='HostTests' or '$(MSBuildProjectName)'=='IoTests' or '$(MSBuildProjectName)'=='CompositionTests')">
    <ItemGroup>
      <RedPrismRuntimeDependency Include="$(RedPrismVcpkgRuntimeDir)yyjson.dll" />
      <RedPrismRuntimeDependency Include="$(RedPrismVcpkgRuntimeDir)zip.dll" Condition="Exists('$(RedPrismVcpkgRuntimeDir)zip.dll')" />
      <RedPrismRuntimeDependency Include="$(RedPrismVcpkgRuntimeDir)zipd.dll" Condition="Exists('$(RedPrismVcpkgRuntimeDir)zipd.dll')" />
      <RedPrismRuntimeDependency Include="$(RedPrismVcpkgRuntimeDir)z.dll" Condition="Exists('$(RedPrismVcpkgRuntimeDir)z.dll')" />
      <RedPrismRuntimeDependency Include="$(RedPrismVcpkgRuntimeDir)zd.dll" Condition="Exists('$(RedPrismVcpkgRuntimeDir)zd.dll')" />
      <RedPrismRuntimeDependency Include="$(RedPrismVcpkgRuntimeDir)zlib1.dll" Condition="Exists('$(RedPrismVcpkgRuntimeDir)zlib1.dll')" />
      <RedPrismRuntimeDependency Include="$(RedPrismVcpkgRuntimeDir)zlibd1.dll" Condition="Exists('$(RedPrismVcpkgRuntimeDir)zlibd1.dll')" />
    </ItemGroup>
    <Error Condition="'%(RedPrismRuntimeDependency.Identity)'!='' and !Exists('%(RedPrismRuntimeDependency.Identity)')"
           Text="Missing vcpkg runtime dependency: %(RedPrismRuntimeDependency.Identity). Run .\vcpkg-install.ps1 -Platform $(Platform)." />
    <Copy SourceFiles="@(RedPrismRuntimeDependency)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <PropertyGroup Condition="'$(MSBuildProjectExtension)'=='.vcxproj' and '$(Configuration)'=='Release'">
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)'=='.vcxproj' and '$(Configuration)'=='Release'">
    <ClCompile>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <WholeProgramOptimization>true</WholeProgramOptimization>
    </ClCompile>
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
    </Link>
    <Lib><LinkTimeCodeGeneration>true</LinkTimeCodeGeneration></Lib>
  </ItemDefinitionGroup>
  <Target Name="ValidateMsvcToolsVersion" BeforeTargets="PrepareForBuild" Condition="'$(MSBuildProjectExtension)'=='.vcxproj'">
    <Error Condition="!$([System.String]::Copy('$(VCToolsVersion)').StartsWith('$(RequiredMsvcToolsVersion).'))" Text="This project requires MSVC build tools $(RequiredMsvcToolsVersion).x; selected $(VCToolsVersion). Install and select the required default C++ toolset." />
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)Build/NativeBuildPolicy.targets" />
</Project>
