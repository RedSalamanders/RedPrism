{
  "version": 1,
  "project": "RedPrism",
  "repository": "RedSalamanders/RedPrism",
  "defaultBranch": "main",
  "nativeInventory": "Tests/native-test-files.json",
  "runtimeFiles": [
    "DxUi.provenance.json"
  ],
  "scopes": [
    {
      "name": "Host",
      "native": true,
      "reuse": false
    },
    {
      "name": "Document",
      "native": true,
      "reuse": true
    },
    {
      "name": "IO",
      "native": true,
      "reuse": false
    },
    {
      "name": "Composition",
      "native": true,
      "reuse": true
    },
    {
      "name": "Runtime",
      "native": true,
      "reuse": false
    },
    {
      "name": "Stress",
      "native": true,
      "reuse": false,
      "configurations": [
        "ASan Debug"
      ]
    },
    {
      "name": "Performance",
      "native": true,
      "reuse": false
    },
    {
      "name": "Captures",
      "native": true,
      "reuse": false
    },
    {
      "name": "Tooling",
      "native": false,
      "reuse": true,
      "commands": [
        {
          "path": "validate.ps1",
          "arguments": []
        }
      ]
    },
    {
      "name": "Format",
      "native": false,
      "reuse": true,
      "commands": [
        {
          "path": "format.ps1",
          "arguments": [
            "-Check"
          ]
        }
      ]
    }
  ],
  "rules": [
    {
      "pattern": "RedPrism/RedPrism.rc",
      "scopes": [
        "Host",
        "Runtime",
        "Performance",
        "Captures"
      ],
      "reason": "Host checks application STRINGTABLE; application identity and rendered chrome consume resources"
    },
    {
      "pattern": "Tests/HostTests/**",
      "scopes": [
        "Host",
        "Stress"
      ],
      "reason": "host suite and sanitizer stress helpers"
    },
    {
      "pattern": "Tests/DocumentTests/**",
      "scopes": [
        "Document",
        "Stress"
      ],
      "reason": "document suite and sanitizer stress helpers"
    },
    {
      "pattern": "Tests/IoTests/**",
      "scopes": [
        "IO"
      ],
      "reason": "isolated IO suite; external codec/clipboard state is not cached"
    },
    {
      "pattern": "Tests/CompositionTests/**",
      "scopes": [
        "Composition"
      ],
      "reason": "standalone WARP composition suite"
    },
    {
      "pattern": "Tests/BuildProcessTests/*.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "independent tooling contracts; native prerequisites retain explicit owner gates"
    },
    {
      "pattern": "Tests/Support/**",
      "scopes": [
        "*"
      ],
      "reason": "failure routing is shared by every native suite"
    },
    {
      "pattern": "**/*.cpp",
      "scopes": [
        "Format"
      ],
      "reason": "native source formatting"
    },
    {
      "pattern": "**/*.h",
      "scopes": [
        "Format"
      ],
      "reason": "native header formatting"
    },
    {
      "pattern": ".clang-format",
      "scopes": [
        "Format"
      ],
      "reason": "formatter policy"
    },
    {
      "pattern": ".agents/**",
      "scopes": [
        "Tooling"
      ],
      "reason": "repository guidance validation"
    },
    {
      "pattern": "validate*.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "independent validators"
    },
    {
      "pattern": "format.ps1",
      "scopes": [
        "Format",
        "Tooling"
      ],
      "reason": "formatter and discovery contract"
    },
    {
      "pattern": "Tests/Tooling.Tests.ScopedTesting.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "scope-selection/evidence/iteration/public-entrypoint regressions"
    },
    {
      "pattern": "Build/**",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "Dependencies/**",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "Directory.Build.*",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "*.vcxproj",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "*.sln",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "test.ps1",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "build.ps1",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "restore-dxui.ps1",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "Test-Changes.ps1",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "Tests/test-scopes.json",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    }
  ],
  "toolingCommands": [
    "validate.ps1",
    "format.ps1"
  ],
  "prCoverage": [
    {
      "check": "tooling",
      "scopes": [
        "Tooling",
        "Format"
      ]
    },
    {
      "check": "native (x64, Debug)",
      "platform": "x64",
      "configuration": "Debug",
      "scopes": [
        "Host",
        "Document",
        "IO",
        "Composition",
        "Runtime",
        "Performance",
        "Captures"
      ]
    },
    {
      "check": "native (x64, Release)",
      "platform": "x64",
      "configuration": "Release",
      "scopes": [
        "Host",
        "Document",
        "IO",
        "Composition",
        "Runtime",
        "Performance",
        "Captures"
      ]
    },
    {
      "check": "native (x64, ASan Debug)",
      "platform": "x64",
      "configuration": "ASan Debug",
      "scopes": [
        "Host",
        "Document",
        "IO",
        "Composition",
        "Runtime",
        "Stress",
        "Performance",
        "Captures"
      ]
    },
    {
      "check": "native (ARM64, Debug)",
      "platform": "ARM64",
      "configuration": "Debug",
      "scopes": [
        "Host",
        "Document",
        "IO",
        "Composition",
        "Runtime",
        "Performance",
        "Captures"
      ]
    },
    {
      "check": "native (ARM64, Release)",
      "platform": "ARM64",
      "configuration": "Release",
      "scopes": [
        "Host",
        "Document",
        "IO",
        "Composition",
        "Runtime",
        "Performance",
        "Captures"
      ]
    },
    {
      "check": "native (ARM64, ASan Debug)",
      "platform": "ARM64",
      "configuration": "ASan Debug",
      "scopes": [
        "Host",
        "Document",
        "IO",
        "Composition",
        "Runtime",
        "Stress",
        "Performance",
        "Captures"
      ]
    }
  ],
  "prWorkflowDigest": "7688033c48ff386ae2809d0436a398bb70a901df103518309ecc634f12008309",
  "projectBindings": [
    {
      "scope": "Host",
      "path": "Tests/HostTests/HostTests.vcxproj"
    },
    {
      "scope": "Document",
      "path": "Tests/DocumentTests/DocumentTests.vcxproj"
    },
    {
      "scope": "IO",
      "path": "Tests/IoTests/IoTests.vcxproj"
    },
    {
      "scope": "Composition",
      "path": "Tests/CompositionTests/CompositionTests.vcxproj"
    },
    {
      "scope": "Runtime",
      "path": "RedPrism/RedPrism.vcxproj"
    }
  ]
}
