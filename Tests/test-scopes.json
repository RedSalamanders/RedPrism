{
  "version": 2,
  "defaultBranch": "main",
  "buildNumber": "mergeBaseCount",
  "nativeInventory": {
    "path": "Tests/native-test-files.json",
    "exclude": [
      "Specs/**",
      "Measurements/**",
      "legacy/**",
      "ThirdParty/**"
    ],
    "testFolders": [
      "Tests/**"
    ]
  },
  "runtimeFiles": [
    "DxUi.provenance.json"
  ],
  "prose": [
    "README.md",
    "CHANGELOG.md",
    "**/AGENTS.md",
    "docs/**/*.md",
    "Specs/**/*.md",
    ".agents/**/*.md",
    "Changes/**/*.md"
  ],
  "unscoped": [
    "legacy/**",
    "docs/**",
    "Measurements/**",
    "Mockups/**"
  ],
  "scopes": [
    {
      "name": "Host",
      "native": true,
      "reuse": false
    },
    {
      "name": "Document",
      "native": true,
      "reuse": true
    },
    {
      "name": "Composition",
      "native": true,
      "reuse": true
    },
    {
      "name": "Stress",
      "native": true,
      "reuse": false,
      "configurations": [
        "ASan Debug"
      ]
    },
    {
      "name": "Performance",
      "native": true,
      "reuse": false
    },
    {
      "name": "Captures",
      "native": true,
      "reuse": false
    },
    {
      "name": "Tooling",
      "native": false,
      "reuse": true,
      "commands": [
        {
          "path": "validate.ps1",
          "arguments": []
        }
      ]
    },
    {
      "name": "Format",
      "native": false,
      "reuse": true,
      "commands": [
        {
          "path": "format.ps1",
          "arguments": [
            "-Check"
          ]
        }
      ]
    }
  ],
  "rules": [
    {
      "pattern": "validate-skills.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "independent agent guidance validation",
      "exclusive": true
    },
    {
      "pattern": "Tools/Test-AgentGuidance.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "independent agent guidance validation",
      "exclusive": true
    },
    {
      "pattern": "RedPrism/RedPrism.rc",
      "scopes": [
        "Host",
        "Performance",
        "Captures"
      ],
      "reason": "Host checks application STRINGTABLE; application identity and rendered chrome consume resources"
    },
    {
      "pattern": "Tests/HostTests/**",
      "scopes": [
        "Host",
        "Stress"
      ],
      "reason": "host suite and sanitizer stress helpers"
    },
    {
      "pattern": "Tests/DocumentTests/**",
      "scopes": [
        "Document",
        "Stress"
      ],
      "reason": "document suite and sanitizer stress helpers"
    },
    {
      "pattern": "Tests/IoTests/**",
      "scopes": [
        "Format"
      ],
      "reason": "source formatting for the separately admitted IO suite"
    },
    {
      "pattern": "Tests/CompositionTests/**",
      "scopes": [
        "Composition"
      ],
      "reason": "standalone WARP composition suite"
    },
    {
      "pattern": "Tests/BuildProcessTests/*.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "independent tooling contracts; native prerequisites retain explicit owner gates"
    },
    {
      "pattern": "Tests/Support/**",
      "scopes": [
        "*"
      ],
      "reason": "failure routing is shared by every native suite"
    },
    {
      "pattern": "**/*.cpp",
      "scopes": [
        "Format"
      ],
      "reason": "native source formatting",
      "additive": true
    },
    {
      "pattern": "**/*.h",
      "scopes": [
        "Format"
      ],
      "reason": "native header formatting",
      "additive": true
    },
    {
      "pattern": ".clang-format",
      "scopes": [
        "Format"
      ],
      "reason": "formatter policy"
    },
    {
      "pattern": ".agents/**",
      "scopes": [
        "Tooling"
      ],
      "reason": "repository guidance validation"
    },
    {
      "pattern": "validate*.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "independent validators"
    },
    {
      "pattern": "format.ps1",
      "scopes": [
        "Format",
        "Tooling"
      ],
      "reason": "formatter and discovery contract"
    },
    {
      "pattern": "Tests/Tooling.Tests.ScopedTesting.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "scope-selection/evidence/iteration/public-entrypoint regressions"
    },
    {
      "pattern": "Build/**",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "Dependencies/**",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "Directory.Build.*",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "*.vcxproj",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "*.sln",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "test.ps1",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "build.ps1",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "restore-dxui.ps1",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "Test-Changes.ps1",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "Tests/test-scopes.json",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    }
  ],
  "projectBindings": {
    "projects": [
      {
        "path": "Tests/HostTests/HostTests.vcxproj",
        "scopes": [
          "Host",
          "Stress"
        ]
      },
      {
        "path": "Tests/DocumentTests/DocumentTests.vcxproj",
        "scopes": [
          "Document",
          "Stress"
        ]
      },
      {
        "path": "Tests/IoTests/IoTests.vcxproj",
        "scopes": [
          "Format"
        ]
      },
      {
        "path": "Tests/CompositionTests/CompositionTests.vcxproj",
        "scopes": [
          "Composition"
        ]
      },
      {
        "path": "RedPrism/RedPrism.vcxproj",
        "scopes": [
          "Performance",
          "Captures"
        ],
        "overrides": [
          {
            "pattern": "**/*.Tests.*.cpp",
            "scopes": [
              "Format"
            ]
          }
        ]
      }
    ],
    "includeRoots": [
      "Common"
    ],
    "exclude": [
      "legacy/**",
      "ThirdParty/**",
      "Specs/**",
      "Measurements/**",
      ".build/**"
    ]
  },
  "watchedProcesses": [
    "DxUi.ControlTests.exe",
    "DxUi.EmbeddedTests.exe",
    "DxUi.FoundationTests.exe",
    "DxUi.InteractiveLease.exe",
    "RedPrism.exe",
    "HostTests.exe",
    "DocumentTests.exe",
    "IoTests.exe",
    "CompositionTests.exe"
  ],
  "prePushProfiles": [
    {
      "platform": "x64",
      "configuration": "Debug",
      "buildOnly": false
    },
    {
      "platform": "x64",
      "configuration": "Release",
      "buildOnly": false
    },
    {
      "platform": "x64",
      "configuration": "ASan Debug",
      "buildOnly": false
    },
    {
      "platform": "ARM64",
      "configuration": "Debug",
      "buildOnly": true
    },
    {
      "platform": "ARM64",
      "configuration": "Release",
      "buildOnly": true
    },
    {
      "platform": "ARM64",
      "configuration": "ASan Debug",
      "buildOnly": true
    }
  ],
  "instrumentationVariables": [
    "ASAN_OPTIONS"
  ],
  "systemFiles": [
    "d2d1.dll",
    "d3d10warp.dll",
    "d3d11.dll",
    "dwrite.dll",
    "dxgi.dll",
    "windowscodecs.dll"
  ],
  "interactiveObligations": [
    {
      "pattern": "**",
      "suites": [
        "IO",
        "Runtime"
      ],
      "reason": "these suites use the session clipboard; run ./test.ps1 -Suites IO,Runtime after desktop admission"
    }
  ]
}
